{
  "name": "novuslease",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:local": "node local-dev/start-local.mjs",
    "local": "node local-dev/start-local.mjs",
    "dev:detached": "node local-dev/dev-detached.mjs",
    "dev:status": "node local-dev/status.mjs",
    "dev:stop": "node local-dev/stop.mjs",
    "test:e2e:local": "node local-dev/e2e-detached.mjs",
    "test:e2e:local:headed": "node local-dev/e2e-detached.mjs --headed",
    "tests:status": "node local-dev/status.mjs tests",
    "tests:watch": "node local-dev/watch.mjs tests",
    "tests:stop": "node local-dev/stop.mjs tests",
    "server:stop": "node local-dev/stop.mjs server",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:up": "docker compose -f local-dev/docker-compose.yml up -d --wait",
    "db:down": "docker compose -f local-dev/docker-compose.yml down",
    "db:reset": "docker compose -f local-dev/docker-compose.yml down -v",
    "db:push:local": "node local-dev/with-local-db.mjs prisma db push",
    "db:seed:local": "node local-dev/with-local-db.mjs node prisma/seed.mjs",
    "db:studio:local": "node local-dev/with-local-db.mjs prisma studio",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate",
    "db:seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@prisma/pg-worker": "^6.9.0",
    "dotenv": "^17.4.2",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "unrs-resolver": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true
  }
}

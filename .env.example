# ═══════════════════════════════════════════════════════════════════
# NovusLease+ — Environment Configuration (template)
# ═══════════════════════════════════════════════════════════════════
# Copy this file to `.env` and fill in the values. Never commit .env.
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows)

# ───────────────────────────────────────────────────────────────────
# 1. Database (Neon PostgreSQL)
#    Used by: src/lib/prisma.ts · prisma.config.ts · prisma/seed.mjs
#    Create a project at https://console.neon.tech, then paste the
#    connection string. Two typical forms:
#
#      ●  Direct (single connection, for migrations/CLI):
#         postgresql://USER:PASSWORD@EP-XXX.us-east-2.aws.neon.tech/DBNAME?sslmode=require
#
#      ●  Pooled (via PgBouncer, recommended for production web apps):
#         postgresql://USER:PASSWORD@EP-XXX-pooler.us-east-2.aws.neon.tech/DBNAME?sslmode=require&pgbouncer=true
#
#    Replace USER, PASSWORD, EP-XXX and DBNAME below.
# ───────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@EP-XXXXXXXX.us-east-2.aws.neon.tech/novuslease?sslmode=require"

# Optional: separate pooled connection for the app server while the
# un-pooled string above stays for prisma migrate / db push / seed.
# DIRECT_URL="postgresql://USER:PASSWORD@EP-XXXXXXXX.us-east-2.aws.neon.tech/novuslease?sslmode=require"

# ───────────────────────────────────────────────────────────────────
# 1b. Local Docker database (recommended for ALL development & testing)
#     See local-dev/README.md. Set USE_LOCAL_DB=true in .env.local and
#     every process (next dev, Prisma CLI, seed, Playwright) talks to the
#     Docker Postgres instead of Neon. Set it to false / delete to use Neon.
# ───────────────────────────────────────────────────────────────────
USE_LOCAL_DB="true"

# Must match local-dev/docker-compose.yml (user/password/db are enforced
# by the container image; the host port 5434 stays free of other projects).
DATABASE_URL_LOCAL="postgresql://novuslease:novuslease@localhost:5434/novuslease?sslmode=disable"

# Optional — a dedicated Neon string for the one-way Admin → “Sync from
# Neon” button. Falls back to DATABASE_URL when unset. Prefer the direct
# (non-pooler) URL here for bulk sync reads.
# NEON_DATABASE_URL="postgresql://USER:PASSWORD@EP-XXXXXXXX.us-east-2.aws.neon.tech/novuslease?sslmode=require"

# ───────────────────────────────────────────────────────────────────
# 2. App / public URLs
# ───────────────────────────────────────────────────────────────────

# Used by src/app/layout.tsx → metadataBase (canonical URLs, OG images).
# Set to your real domain in production (e.g. https://novuslease.vercel.app).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# App/brand name used in <title> and Open Graph metadata.
NEXT_PUBLIC_APP_NAME="NovusLease+"

# ───────────────────────────────────────────────────────────────────
# 3. Node / runtime
# ───────────────────────────────────────────────────────────────────

# Next.js sets this automatically. You may pin it explicitly in CI.
# NODE_ENV="development"

# ───────────────────────────────────────────────────────────────────
# 4. Admin console (session cookie signing)
# ───────────────────────────────────────────────────────────────────

# Used by src/lib/admin-auth.ts to sign the /admin session cookie.
# Generate with: openssl rand -base64 32 (or `node -e "console.log(crypto.randomBytes(32).toString('base64'))"`)
# A dev fallback exists so the portal works out of the box — always set this
# to a strong secret in production and when deployed publicly.
AUTH_SECRET="replace-me-with-a-long-random-string"

# ═══════════════════════════════════════════════════════════════════
# 5. Roadmap (uncomment as features land)
# ═══════════════════════════════════════════════════════════════════
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...